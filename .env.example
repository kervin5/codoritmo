# Codoritmo environment variables. Copy to .env.local and adjust for your deployment.

# Public address of the site, without a trailing slash. Used for canonical links,
# hreflang, the sitemap, robots.txt and structured data. On Vercel the production
# domain is used automatically when this is unset; elsewhere it defaults to
# http://localhost:3000, so set it in production.
# The official deployment uses https://www.codoritmo.com
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Source repository linked from the app (menu bar and Help menu).
# Defaults to the upstream Codoritmo repository; forks can point it at their own.
# NEXT_PUBLIC_REPOSITORY_URL=https://github.com/your-user/codoritmo
